{
  "schemaVersion": 1,
  "key": "terminal",
  "name": "赛博终端",
  "order": 3,
  "scheme": "dark",
  "swatch": ["#C6FF3D", "#FF3DBB", "#0A0A0B"],
  "webSwatch": ["#D5FF63", "#FFC45E", "#0C0F0D"],
  "webTokens": {
    "bg": "#0C0F0D",
    "surface": "#161815",
    "overlay": "#1C1F16",
    "text": "#F5F4F0",
    "muted": "#BBBDB5",
    "line": "#333A26",
    "accent": "#D5FF63",
    "accent2": "#EDFFAC",
    "accentText": "#D5FF63",
    "onAccent": "#101409",
    "accentBg": "#D5FF63",
    "success": "#D5FF63",
    "warning": "#FFC45E",
    "danger": "#FF9582",
    "mono": "\"JetBrains Mono\", \"SF Mono\", Menlo, Consolas, \"PingFang SC\", \"Microsoft YaHei\", monospace",
    "hero": "linear-gradient(155deg, #24281A, #141613 60%, #1A1C15)",
    "onHero": "#F5F4F0",
    "radiusSm": "3px",
    "radiusMd": "3px",
    "radiusLg": "3px",
    "glass": "#24291C",
    "glassLowEnd": "#161815"
  },
  "webContrast": [
    { "fg": "text", "bg": "#24281A", "min": 10, "label": "Web 终端面板正文" },
    { "fg": "muted", "bg": "#24281A", "min": 6, "label": "Web 终端面板辅助文字" },
    { "fg": "accentText", "bg": "#24281A", "min": 9, "label": "Web 荧光链接" },
    { "fg": "warning", "bg": "#2B2208", "min": 7, "label": "Web 琥珀提醒" },
    { "fg": "onAccent", "bg": "#D5FF63", "min": 10, "label": "Web 主操作深色文字" }
  ],
  "tokens": {
    "bg": "#0A0A0B",
    "surface": "#111113",
    "overlay": "#111113",
    "text": "#F2F2F0",
    "muted": "#9A9A94",
    "line": "#26262A",
    "accent": "#C6FF3D",
    "accent2": "#FF3DBB",
    "accentText": "#C6FF3D",
    "onAccent": "#0A0A0B",
    "accentBg": "#C6FF3D",
    "success": "#C6FF3D",
    "warning": "#FFC53D",
    "danger": "#FF5A5A",
    "successBg": "#1B2410",
    "warningBg": "#2B2208",
    "dangerBg": "#2E1111",
    "hero": "#111113",
    "onHero": "#F2F2F0",
    "radiusSm": "4px",
    "radiusMd": "4px",
    "radiusLg": "4px",
    "radiusBtn": "2px",
    "shadow": "none",
    "font": "\"HarmonyOS Sans SC\", \"PingFang SC\", system-ui, -apple-system, \"Microsoft YaHei\", sans-serif",
    "mono": "\"JetBrains Mono\", \"SF Mono\", ui-monospace, Menlo, Consolas, monospace",
    "glass": "#1C1C1F",
    "glassLowEnd": "#111113",
    "blur": "none",
    "borderStrong": "#3A3A40",
    "surfaceTint": "#16161A",
    "shadowRest": "0 0 0 1px #26262A",
    "shadowHover": "0 0 0 1px #C6FF3D, 0 0 24px -8px rgba(198,255,61,.35)",
    "insetHighlight": "none",
    "motionBase": "160ms",
    "motionEase": "cubic-bezier(.2,.8,.2,1)",
    "decor": "1"
  },
  "native": {
    "tabBar": { "color": "#9A9A94", "selectedColor": "#C6FF3D", "backgroundColor": "#0A0A0B", "borderStyle": "white" },
    "navBar": { "frontColor": "#ffffff", "backgroundColor": "#0A0A0B" },
    "windowBackground": "#0A0A0B"
  },
  "contrast": [
    { "fg": "text", "bg": "#111113", "min": 16.8, "label": "正文 / 面板" },
    { "fg": "muted", "bg": "#111113", "min": 6.6, "label": "次要文字 / 面板" },
    { "fg": "accent", "bg": "#111113", "min": 15.9, "label": "荧光绿 / 面板" },
    { "fg": "onAccent", "bg": "#C6FF3D", "min": 16.7, "label": "按钮黑字 / 荧光绿" },
    { "fg": "success", "bg": "#1B2410", "min": 4.5, "label": "成功标签" },
    { "fg": "warning", "bg": "#2B2208", "min": 4.5, "label": "警示标签" },
    { "fg": "danger", "bg": "#2E1111", "min": 4.5, "label": "危险标签" },
    { "fg": "muted", "bg": "#111113", "min": 6.66, "label": "侧栏次要文字 / 侧栏底" },
    { "fg": "accentText", "bg": "#1C1C1F", "min": 14.38, "label": "侧栏当前项文字 / 当前项底" },
    { "fg": "text", "bg": "#111113", "min": 16.8, "label": "管理端顶栏用户菜单文字 / 顶栏底" },
    { "fg": "text", "bg": "#0A0A0B", "min": 17.6, "label": "登录页品牌标题 / 页面底" },
    { "fg": "muted", "bg": "#0A0A0B", "min": 6.99, "label": "登录页副标题 / 页面底" },
    { "fg": "onHero", "bg": "#111113", "min": 16.8, "label": "Hero 文字 / Hero 底" }
  ]
}
