{
  "schemaVersion": 1,
  "key": "bento",
  "name": "极光 Bento",
  "order": 2,
  "scheme": "light",
  "swatch": ["#4F46E5", "#FF5C8A", "#F3F4FA"],
  "tokens": {
    "bg": "#F3F4FA",
    "surface": "#FFFFFF",
    "overlay": "#FFFFFF",
    "text": "#11121A",
    "muted": "#5E6378",
    "line": "#E6E8F0",
    "accent": "#4F46E5",
    "accent2": "#FF5C8A",
    "accentText": "#4F46E5",
    "onAccent": "#FFFFFF",
    "accentBg": "#11121A",
    "success": "#047857",
    "warning": "#B45309",
    "danger": "#BE123C",
    "successBg": "#E7F6EF",
    "warningBg": "#FEF3E2",
    "dangerBg": "#FDE8EC",
    "hero": "linear-gradient(135deg, #4F46E5 0%, #7C3AED 55%, #DB2777 100%)",
    "onHero": "#FFFFFF",
    "radiusSm": "16px",
    "radiusMd": "16px",
    "radiusLg": "28px",
    "radiusBtn": "999px",
    "shadow": "0 1px 2px rgba(17,18,26,.04), 0 12px 32px -12px rgba(49,46,129,.14)",
    "font": "\"MiSans\", \"HarmonyOS Sans SC\", \"PingFang SC\", system-ui, -apple-system, \"Microsoft YaHei\", sans-serif",
    "mono": "\"SF Mono\", \"JetBrains Mono\", ui-monospace, Menlo, Consolas, monospace",
    "glass": "#F6F7FB",
    "glassLowEnd": "#FFFFFF",
    "blur": "none",
    "decor": "1"
  },
  "native": {
    "tabBar": { "color": "#5E6378", "selectedColor": "#4F46E5", "backgroundColor": "#F3F4FA", "borderStyle": "black" },
    "navBar": { "frontColor": "#000000", "backgroundColor": "#F3F4FA" },
    "windowBackground": "#F3F4FA"
  },
  "contrast": [
    { "fg": "text", "bg": "#FFFFFF", "min": 18.6, "label": "正文 / 白卡" },
    { "fg": "muted", "bg": "#FFFFFF", "min": 5.9, "label": "次要文字 / 白卡" },
    { "fg": "accentText", "bg": "#FFFFFF", "min": 6.2, "label": "强调色 / 白卡" },
    { "fg": "onAccent", "bg": "#11121A", "min": 15, "label": "主按钮文字 / 主按钮底" },
    { "fg": "onAccent", "bg": "#4F46E5", "min": 6.2, "label": "管理端主按钮文字 / 强调色" },
    { "fg": "onHero", "bg": "#DB2777", "min": 4.59, "label": "Hero 白字 / 渐变亮端" },
    { "fg": "onHero", "bg": "#4F46E5", "min": 4.5, "label": "Hero 白字 / 渐变起点" },
    { "fg": "onHero", "bg": "#7C3AED", "min": 5.6, "label": "管理端顶栏白字 / 渐变中段" },
    { "fg": "success", "bg": "#E7F6EF", "min": 4.9, "label": "成功标签" },
    { "fg": "warning", "bg": "#FEF3E2", "min": 4.5, "label": "警示标签" },
    { "fg": "danger", "bg": "#FDE8EC", "min": 5.3, "label": "危险标签" }
  ]
}
