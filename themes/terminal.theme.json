{
  "schemaVersion": 1,
  "key": "terminal",
  "name": "赛博终端",
  "order": 3,
  "scheme": "dark",
  "swatch": ["#C6FF3D", "#FF3DBB", "#0A0A0B"],
  "tokens": {
    "bg": "#0A0A0B",
    "surface": "#111113",
    "overlay": "#111113",
    "text": "#F2F2F0",
    "muted": "#9A9A94",
    "line": "#26262A",
    "accent": "#C6FF3D",
    "accent2": "#FF3DBB",
    "accentText": "#C6FF3D",
    "onAccent": "#0A0A0B",
    "accentBg": "#C6FF3D",
    "success": "#C6FF3D",
    "warning": "#FFC53D",
    "danger": "#FF5A5A",
    "successBg": "#1B2410",
    "warningBg": "#2B2208",
    "dangerBg": "#2E1111",
    "hero": "#111113",
    "onHero": "#F2F2F0",
    "radiusSm": "4px",
    "radiusMd": "4px",
    "radiusLg": "4px",
    "radiusBtn": "2px",
    "shadow": "none",
    "font": "\"HarmonyOS Sans SC\", \"PingFang SC\", system-ui, -apple-system, \"Microsoft YaHei\", sans-serif",
    "mono": "\"JetBrains Mono\", \"SF Mono\", ui-monospace, Menlo, Consolas, monospace",
    "glass": "#1C1C1F",
    "glassLowEnd": "#111113",
    "blur": "none",
    "decor": "1"
  },
  "native": {
    "tabBar": { "color": "#9A9A94", "selectedColor": "#C6FF3D", "backgroundColor": "#0A0A0B", "borderStyle": "white" },
    "navBar": { "frontColor": "#ffffff", "backgroundColor": "#0A0A0B" },
    "windowBackground": "#0A0A0B"
  },
  "contrast": [
    { "fg": "text", "bg": "#111113", "min": 16.8, "label": "正文 / 面板" },
    { "fg": "muted", "bg": "#111113", "min": 6.6, "label": "次要文字 / 面板" },
    { "fg": "accent", "bg": "#111113", "min": 15.9, "label": "荧光绿 / 面板" },
    { "fg": "onAccent", "bg": "#C6FF3D", "min": 16.7, "label": "按钮黑字 / 荧光绿" },
    { "fg": "success", "bg": "#1B2410", "min": 4.5, "label": "成功标签" },
    { "fg": "warning", "bg": "#2B2208", "min": 4.5, "label": "警示标签" },
    { "fg": "danger", "bg": "#2E1111", "min": 4.5, "label": "危险标签" }
  ]
}
